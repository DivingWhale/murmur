[Unit]
Description=Murmur voice inbox
After=network.target

[Service]
WorkingDirectory=%h/projects/murmur/backend
ExecStart=/usr/bin/python3 server.py
EnvironmentFile=%h/.config/murmur/service.env
Environment=MURMUR_DATA=%h/.local/share/murmur
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
